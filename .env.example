# Copy to .env and fill in. docker compose picks that file up automatically;
# running uvicorn directly means setting these in your shell instead.

# Shared secret for every write endpoint (POST /leads, POST /webhook,
# POST /leads/{id}/status, DELETE /leads/{id}) and for GET /api/leads.
# Send it as the X-Api-Token header. Leave this empty and the app generates
# a token at startup and logs it - the endpoints stay closed either way.
LEAD_TRIAGE_TOKEN=

# "demo" classifies by keyword without any API call - this is the default and
# what the public demo runs. "live" only takes effect together with a key.
LEAD_TRIAGE_MODE=demo

# Optional. With a key the classifier calls GPT; without one it falls back to
# the deterministic demo mode regardless of LEAD_TRIAGE_MODE.
OPENAI_API_KEY=

# Optional. Defaults to gpt-4o-mini when unset.
OPENAI_MODEL=

# Password for the Postgres container in docker-compose.yml. Defaults to
# "leads" when unset, which is fine locally - the database publishes no port
# to the host. Change it for anything that is not your own machine.
POSTGRES_PASSWORD=

# Only needed when running uvicorn directly against a Postgres you started
# yourself. Compose sets this for the app container on its own; leaving it
# empty here does not affect the compose setup. Unset means SQLite.
# DATABASE_URL=postgresql://leads:leads@localhost:5432/leads
